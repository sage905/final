---
# {{ ansible_managed }}
name: healthchecks

services:
  healthchecks:
    image: {{ healthchecks_image }}
    container_name: healthchecks
    restart: always
    environment:
      SITE_ROOT: "{{ healthchecks_site_root }}"
      SITE_NAME: "Healthchecks"
      ALLOWED_HOSTS: "{{ healthchecks_site_root | urlsplit('hostname') }}"
      SECRET_KEY: "{{ healthchecks_secret_key }}"
      DEBUG: "False"
      REGISTRATION_OPEN: "{{ 'True' if healthchecks_registration_open else 'False' }}"
{% if healthchecks_superuser_email | length > 0 and healthchecks_superuser_password | length > 0 %}
      SUPERUSER_EMAIL: "{{ healthchecks_superuser_email }}"
      SUPERUSER_PASSWORD: "{{ healthchecks_superuser_password }}"
{% endif %}
      DEFAULT_FROM_EMAIL: "{{ healthchecks_default_from_email }}"
{% if healthchecks_email_host | length > 0 %}
      EMAIL_HOST: "{{ healthchecks_email_host }}"
      EMAIL_PORT: "{{ healthchecks_email_port }}"
      EMAIL_HOST_USER: "{{ healthchecks_email_user }}"
      EMAIL_HOST_PASSWORD: "{{ healthchecks_email_password }}"
      EMAIL_USE_TLS: "{{ 'True' if healthchecks_email_use_tls else 'False' }}"
{% endif %}
    # Ansible pre-chowns /srv/healthchecks/data to UID 999 (matches
    # the `hc` user inside the image). The local_settings.py mount
    # overrides the image's hardcoded sqlite path (/opt/healthchecks/
    # hc.sqlite, not writable) to point at /data instead.
    volumes:
      - "{{ healthchecks_data_dir }}/data:/data"
      - "{{ healthchecks_data_dir }}/local_settings.py:/opt/healthchecks/hc/local_settings.py:ro"
    networks:
      - shared

networks:
  shared:
    name: {{ healthchecks_shared_network }}
    external: true
