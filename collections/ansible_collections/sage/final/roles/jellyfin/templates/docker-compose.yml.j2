---
# {{ ansible_managed }}
name: jellyfin

services:
  jellyfin:
    image: {{ jellyfin_image }}
    container_name: jellyfin
    restart: always
    # Run as the media library owner:group instead of root, so files Jellyfin
    # writes into /media stay owned by the human admin and the shared group.
    user: "{{ jellyfin_run_uid }}:{{ jellyfin_run_gid }}"
    environment:
      JELLYFIN_PublishedServerUrl: "https://{{ jellyfin_fqdn }}"
    volumes:
      - "{{ jellyfin_data_dir }}/config:/config"
      - "{{ jellyfin_data_dir }}/cache:/cache"
      - "{{ jellyfin_media_path }}:/media"
{% if jellyfin_publish_dlna_port %}
    ports:
      - "7359:7359/udp"
{% endif %}
    networks:
      - shared

networks:
  shared:
    name: {{ jellyfin_shared_network }}
    external: true
