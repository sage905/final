---
# {{ ansible_managed }}
name: pelican

services:
  panel:
    image: {{ pelican_panel_image }}
    container_name: pelican-panel
    restart: always
    # The image runs as www-data (UID 82) and its internal Caddy binds
    # {{ pelican_panel_container_port }} directly. Linux blocks non-root binds below 1024, and the
    # image's caddy binary carries no file capabilities, so lower the
    # unprivileged-port threshold inside this container's network namespace.
    # List form (KEY=VALUE); the map form also works under Compose v2.
    sysctls:
      - "net.ipv4.ip_unprivileged_port_start={{ pelican_panel_container_port }}"
    environment:
      # XDG_DATA_HOME points Pelican's persistent state (SQLite database,
      # generated APP_KEY, settings) at the bind-mounted /pelican-data.
      XDG_DATA_HOME: /pelican-data
      APP_ENV: "{{ pelican_panel_app_env }}"
      APP_DEBUG: "{{ pelican_panel_app_debug | string | lower }}"
      APP_URL: "https://{{ pelican_panel_fqdn }}"
      APP_TIMEZONE: "{{ pelican_panel_timezone }}"
      ADMIN_EMAIL: "{{ pelican_panel_admin_email }}"
      # The shared Caddy terminates TLS in front of this stack. BEHIND_PROXY
      # tells Pelican's in-container Caddy to serve plain HTTP on :80 and skip
      # its own Let's Encrypt provisioning (which otherwise demands LE_EMAIL
      # and fails behind a proxy).
      BEHIND_PROXY: "true"
      # Comma-separated CIDRs the in-container Caddy trusts as upstream
      # proxies (NOT a Laravel `*` — Pelican feeds this into Caddy's
      # `trusted_proxies static`, which needs real CIDRs). Covers the private
      # range the shared `web` Docker network is assigned from.
      TRUSTED_PROXIES: "{{ pelican_panel_trusted_proxies }}"
      MAIL_DRIVER: "{{ pelican_panel_mail_driver }}"
    volumes:
      - "{{ pelican_panel_data_dir }}/data:/pelican-data"
      - "{{ pelican_panel_data_dir }}/logs:/var/www/html/storage/logs"
    extra_hosts:
      - "host.containers.internal:host-gateway"
      - "host.docker.internal:host-gateway"
      - "{{ pelican_panel_fqdn }}:host-gateway"
    networks:
      - shared

networks:
  shared:
    name: {{ pelican_panel_shared_network }}
    external: true
