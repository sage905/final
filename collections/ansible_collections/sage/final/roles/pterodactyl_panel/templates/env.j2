# {{ ansible_managed }}
APP_ENV=production
APP_DEBUG=false
APP_KEY={{ ptero_effective_app_key }}
APP_TIMEZONE={{ ptero_timezone }}
APP_URL=https://{{ ptero_panel_fqdn }}
APP_SERVICE_AUTHOR={{ ptero_admin_email }}
APP_ENVIRONMENT_ONLY=false

TRUSTED_PROXIES=*

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE={{ ptero_db_name }}
DB_USERNAME={{ ptero_db_user }}
DB_PASSWORD={{ ptero_effective_db_password }}

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=cache
REDIS_PORT=6379

MAIL_DRIVER={{ ptero_mail_driver }}
MAIL_FROM={{ ptero_mail_from }}
MAIL_HOST={{ ptero_mail_host }}
MAIL_PORT={{ ptero_mail_port }}
MAIL_USERNAME={{ ptero_mail_username }}
MAIL_PASSWORD={{ ptero_mail_password }}
MAIL_ENCRYPTION={{ ptero_mail_encryption }}
