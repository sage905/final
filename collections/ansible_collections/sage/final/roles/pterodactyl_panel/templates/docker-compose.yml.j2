---
# {{ ansible_managed }}
name: pterodactyl

services:
  database:
    image: {{ ptero_db_image }}
    container_name: pterodactyl-database
    restart: always
    command: --default-authentication-plugin=mysql_native_password
    volumes:
      - "{{ ptero_data_dir }}/database:/var/lib/mysql"
    environment:
      MYSQL_DATABASE: "{{ ptero_db_name }}"
      MYSQL_USER: "{{ ptero_db_user }}"
      MYSQL_PASSWORD: "{{ ptero_effective_db_password }}"
      MYSQL_ROOT_PASSWORD: "{{ ptero_effective_db_root_password }}"
    networks:
      - pterodactyl

  cache:
    image: {{ ptero_cache_image }}
    container_name: pterodactyl-cache
    restart: always
    networks:
      - pterodactyl

  panel:
    image: {{ ptero_panel_image }}
    container_name: pterodactyl-panel
    restart: always
    ports:
      - "127.0.0.1:8080:80"
    depends_on:
      - database
      - cache
    env_file:
      - .env
    volumes:
      - "{{ ptero_data_dir }}/var:/app/var"
      - "{{ ptero_data_dir }}/nginx:/etc/nginx/http.d"
      - "{{ ptero_data_dir }}/logs:/app/storage/logs"
    networks:
      - pterodactyl

  caddy:
    image: {{ ptero_caddy_image }}
    container_name: pterodactyl-caddy
    restart: always
    ports:
      - "80:80"
      - "443:443"
    depends_on:
      - panel
    volumes:
      - "{{ ptero_data_dir }}/caddy/Caddyfile:/etc/caddy/Caddyfile:ro"
      - "{{ ptero_data_dir }}/caddy/data:/data"
      - "{{ ptero_data_dir }}/caddy/config:/config"
    networks:
      - pterodactyl

networks:
  pterodactyl:
    name: pterodactyl
