---
# {{ ansible_managed }}
name: sonarr

services:
  sonarr:
    image: {{ sonarr_image }}
    container_name: {{ sonarr_container_name }}
    restart: always
{% if sonarr_vpn_container | length > 0 %}
    # Join the VPN gateway's network namespace. Sonarr therefore has NO network
    # interfaces of its own — every packet leaves through the VPN tunnel, or is
    # dropped by the gateway's kill switch. As a consequence this service cannot
    # declare `networks:` or `ports:`; the web UI ({{ sonarr_container_port }})
    # is reached through the VPN container's name (see the surfshark role).
    network_mode: "container:{{ sonarr_vpn_container }}"
{% endif %}
    environment:
      PUID: "{{ sonarr_puid }}"
      PGID: "{{ sonarr_pgid }}"
      UMASK: "{{ sonarr_umask }}"
      TZ: "{{ sonarr_timezone }}"
    volumes:
      - "{{ sonarr_data_dir }}/config:/config"
      - "{{ sonarr_tv_path }}:/tv"
      - "{{ sonarr_downloads_path }}:/downloads"
{% if sonarr_vpn_container | length == 0 %}
    # No VPN: Sonarr runs on the shared network with its own address. Caddy
    # reaches it directly at "{{ sonarr_container_name }}:{{ sonarr_container_port }}".
    networks:
      - shared

networks:
  shared:
    name: {{ sonarr_shared_network }}
    external: true
{% endif %}
