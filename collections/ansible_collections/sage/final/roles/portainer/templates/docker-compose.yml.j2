---
# {{ ansible_managed }}
name: portainer

services:
  portainer:
    image: {{ portainer_image }}
    container_name: portainer
    restart: always
    # Portainer talks to the host Docker socket, mounted into the
    # container at the path Portainer expects. The Docker engine is
    # installed by the shared sage.final.docker role, so the socket
    # exists at boot.
    volumes:
      - "{{ portainer_data_dir }}/data:/data"
      - "/var/run/docker.sock:/var/run/docker.sock"
    # `--http-enabled` tells Portainer to expose its UI on HTTP (Caddy
    # terminates TLS for us). Without it, Portainer would also try to
    # listen on HTTPS:9443 with its own self-signed cert.
    command: ["--http-enabled"]
    networks:
      - shared

networks:
  shared:
    name: {{ portainer_shared_network }}
    external: true
