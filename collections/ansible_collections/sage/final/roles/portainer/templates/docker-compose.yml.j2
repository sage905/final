---
# {{ ansible_managed }}
name: portainer

services:
  portainer:
    image: {{ portainer_image }}
    container_name: portainer
    restart: always
    # Portainer talks to the system podman socket via its Docker-compat
    # endpoint. Mounted into the container at the path Portainer expects
    # for a Docker socket. The dependencies task in this role enables
    # the system podman.socket so this file exists at boot.
    volumes:
      - "{{ portainer_data_dir }}/data:/data"
      - "/run/podman/podman.sock:/var/run/docker.sock"
    # `--http-enabled` tells Portainer to expose its UI on HTTP (Caddy
    # terminates TLS for us). Without it, Portainer would also try to
    # listen on HTTPS:9443 with its own self-signed cert.
    command: ["--http-enabled"]
    networks:
      - shared

networks:
  shared:
    name: {{ portainer_shared_network }}
    external: true
